---
import Base from "../../layouts/Base.astro";
import ContactCard from "../../components/ContactCard.astro";
import ConsumablesList from "../../components/ConsumablesList.astro";
import TroubleshootingList from "../../components/TroubleshootingList.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import ReportIssue from "../../components/ReportIssue.astro";
import Badge from "../../components/ui/Badge.astro";
import Card from "../../components/ui/Card.astro";
import Note from "../../components/ui/Note.astro";
import Section from "../../components/ui/Section.astro";
import { getMachineByCode, getMachineDetails, fileUrl, displayFilename } from "../../lib/pb";

const machine = await getMachineByCode(Astro.params.code ?? "");
if (!machine) {
  return Astro.rewrite("/404");
}

const { troubleshooting, consumables } = await getMachineDetails(machine);
const contacts = machine.expand?.contacts ?? [];
const makeModel = [machine.make, machine.model].filter(Boolean).join(" ");
const details = [
  ["Code", machine.code],
  ["Make", machine.make],
  ["Model", machine.model],
  ["Serial", machine.serial],
  ["Category", machine.category],
  ["Area", machine.area],
].filter(([, value]) => value);
const mono = new Set(["Code", "Model", "Serial"]);
const updated = new Date(machine.updated.replace(" ", "T")).toLocaleDateString("en-US", { dateStyle: "medium" });
const fileType = (file: string) => file.split(".").pop()?.toUpperCase() ?? "";

const jumpLinks = [
  ["#problem", "Having a problem?"],
  ["#how-to-use", "How to use"],
  consumables.length > 0 && ["#consumables", "Consumables"],
  machine.documents.length > 0 && ["#documents", "Manuals"],
  ["#details", "Details"],
].filter(Boolean) as string[][];
---

<Base title={machine.name} description={machine.summary || `How to use and troubleshoot the ${machine.name}.`}>
  <nav class="breadcrumb copy-14 no-print" aria-label="Breadcrumb">
    <a href="/">Machines</a>
    {
      machine.area && (
        <>
          <span aria-hidden="true">/</span>
          <span>{machine.area}</span>
        </>
      )
    }
  </nav>

  <header class:list={["machine-header", { "has-photo": machine.photo }]}>
    {
      machine.photo && (
        <img src={fileUrl(machine, machine.photo, "800x0")} alt={machine.name} class="photo" width="800" />
      )
    }
    <div class="intro">
      <div class="badges">
        <Badge variant="gray"><span class="mono">{machine.code}</span></Badge>
        <StatusBadge status={machine.status} />
      </div>
      <h1>{machine.name}</h1>
      {makeModel && <p class="muted">{makeModel}</p>}
      {machine.summary && <p class="summary">{machine.summary}</p>}
    </div>
    <div class="header-extra">
      {machine.training_required && <Badge variant="blue">Training required</Badge>}
      <div class="status-block">
        {
          machine.status === "out_of_service" ? (
            <Note variant="error" label="Out of service.">
              This machine is out of service and cannot be used. Contact the{" "}
              {contacts.length > 0 ? <a href="#contacts">area lead</a> : "area lead"} for more information.
            </Note>
          ) : machine.status === "repair_in_progress" ? (
            <Note variant="warning" label="Under repair.">
              This machine is currently under repair.
            </Note>
          ) : (
            <ReportIssue machineId={machine.id} machineName={machine.name} machineCode={machine.code} />
          )
        }
      </div>
    </div>
  </header>

  <div class="layout">
    <nav class="jump no-print" aria-label="On this page">
      <p class="jump-title label-12 subtle">On this page</p>
      {jumpLinks.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>

    <div class="sections">

      <Section id="problem" title="Having a problem?" description="Common issues and how to fix them.">
        <Note variant="error" label="Unsafe or damaged?">
          Stop and power it off, put an out-of-service tag on it, and contact the steward below.
        </Note>
        {
          troubleshooting.length > 0 ? (
            <TroubleshootingList entries={troubleshooting} />
          ) : (
            <Note>No troubleshooting notes yet. Contact the steward below.</Note>
          )
        }
        {
          contacts.length > 0 && (
            <div id="contacts" class="contacts-anchor">
              <Card title="Who to contact" padded={false}>
                {contacts.map((c) => (
                  <ContactCard contact={c} />
                ))}
              </Card>
            </div>
          )
        }
      </Section>

      <Section id="how-to-use" title="How to use">
        {
          machine.training_required && (
            <Note variant="warning" label="Training required.">
              You must complete training before using this machine. Ask a steward to schedule it.
            </Note>
          )
        }
        {
          machine.safety && (
            <Card title="Safety">
              <div class="prose" set:html={machine.safety} />
            </Card>
          )
        }
        {
          machine.quick_start && (
            <Card title="Quick start">
              <div class="prose" set:html={machine.quick_start} />
            </Card>
          )
        }
        {!machine.safety && !machine.quick_start && <Note>No operating instructions yet.</Note>}
      </Section>

      {
        consumables.length > 0 && (
          <Section id="consumables" title="Consumables & parts" description="Replacement parts and supplies this machine uses.">
            <ConsumablesList items={consumables} />
          </Section>
        )
      }

      {
        machine.documents.length > 0 && (
          <Section id="documents" title="Manuals & schematics">
            <ul class="docs">
              {machine.documents.map((file) => (
                <li>
                  <a href={fileUrl(machine, file)} target="_blank" rel="noopener">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
                      <path d="M9 1.75H4.25a1 1 0 0 0-1 1v10.5a1 1 0 0 0 1 1h7.5a1 1 0 0 0 1-1V5.5L9 1.75Z" />
                      <path d="M9 1.75V5.5h3.75" />
                    </svg>
                    <span class="doc-name">{displayFilename(file)}</span>
                    <Badge size="small">{fileType(file)}</Badge>
                  </a>
                </li>
              ))}
            </ul>
          </Section>
        )
      }

      <Section id="details" title="Details">
        <Card padded={false}>
          <dl class="details copy-14">
            {
              details.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd class:list={{ mono: mono.has(label) }}>{value}</dd>
                </div>
              ))
            }
          </dl>
          {machine.specs && <div class="prose specs" set:html={machine.specs} />}
        </Card>
        <p class="label-12 subtle">Last updated {updated}</p>
      </Section>
    </div>
  </div>
</Base>

<script>
  // Highlight the jump link for the section currently in view.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".jump a")];
  const sections = links.map((a) => document.getElementById(a.hash.slice(1)));

  // A clicked link stays highlighted until the reader scrolls themselves, even if its
  // section is too close to the bottom of the page to reach the highlight line.
  let pinned = -1;
  links.forEach((a, i) =>
    a.addEventListener("click", () => {
      pinned = i;
      update();
    })
  );
  for (const type of ["wheel", "touchstart", "keydown"]) {
    window.addEventListener(type, () => (pinned = -1), { passive: true });
  }

  function update() {
    // The current section is the last one whose top has scrolled past the upper third of the screen.
    let current = 0;
    sections.forEach((section, i) => {
      if (section && section.getBoundingClientRect().top <= window.innerHeight / 3) current = i;
    });
    // At the very bottom, the last section may be too short to reach that line.
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
      current = sections.length - 1;
    }
    if (pinned >= 0) current = pinned;
    links.forEach((a, i) => (i === current ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
  }

  let queued = false;
  window.addEventListener(
    "scroll",
    () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    },
    { passive: true }
  );
  update();
</script>

<style>
  .breadcrumb {
    display: flex;
    gap: 8px;
    color: var(--text-subtle);
    margin-bottom: 20px;
  }
  .breadcrumb a {
    color: var(--text-muted);
  }
  /* On phones the photo is a thumbnail so "Having a problem?" stays near the top of the screen. */
  .machine-header {
    display: grid;
    gap: 16px;
  }
  .machine-header.has-photo {
    grid-template-columns: 1fr 88px;
    align-items: start;
  }
  .photo {
    grid-column: 2;
    grid-row: 1;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-border-small);
  }
  @media (min-width: 720px) {
    .machine-header.has-photo {
      grid-template-columns: 340px 1fr;
      grid-template-rows: auto 1fr;
      align-items: start;
      gap: 16px 32px;
    }
    .photo {
      grid-column: 1;
      grid-row: 1 / span 2;
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-lg);
    }
    .has-photo .intro,
    .has-photo .header-extra {
      grid-column: 2;
    }
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }
  .intro p {
    margin: 4px 0 0;
  }
  .summary {
    color: var(--text-muted);
    max-width: 60ch;
    padding-top: 8px;
  }
  /* Training badge and status alert/report button: full width under the intro on phones,
     under the intro beside the photo on desktop. */
  .header-extra {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .has-photo .intro {
    grid-row: 1;
  }
  @media (max-width: 719px) {
    .has-photo .intro {
      grid-column: 1;
    }
  }
  .status-block {
    align-self: stretch;
  }
  .status-block :global(.note) {
    max-width: 60ch;
  }
  .contacts-anchor {
    scroll-margin-top: 80px;
  }
  /* Phones: jump links are a horizontal scrolling row above the content. */
  .jump {
    display: flex;
    gap: 4px;
    margin: 28px -16px 0;
    padding: 0 16px;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--border);
  }
  .jump-title {
    display: none;
  }
  .jump a {
    flex: none;
    padding: 10px 12px;
    font-size: 14px;
    color: var(--text-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .jump a:hover,
  .jump a[aria-current="true"] {
    color: var(--text);
    text-decoration: none;
    border-bottom-color: var(--gray-1000);
  }
  .sections {
    min-width: 0;
  }

  /* Wider screens: a sticky vertical column to the left of the content. */
  @media (min-width: 900px) {
    .layout {
      display: grid;
      grid-template-columns: 180px 1fr;
      gap: 48px;
      align-items: start;
      margin-top: 40px;
    }
    .jump {
      position: sticky;
      top: 80px;
      flex-direction: column;
      gap: 2px;
      margin: 0;
      padding: 0;
      overflow: visible;
      border-bottom: none;
      border-left: 1px solid var(--border);
    }
    .jump-title {
      display: block;
      margin: 0 0 8px;
      padding-left: 14px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .jump a {
      padding: 6px 12px;
      margin: 0 0 0 -1px;
      border-bottom: none;
      border-left: 2px solid transparent;
    }
    .jump a:hover,
    .jump a[aria-current="true"] {
      border-left-color: var(--gray-1000);
    }
    .sections > :global(section:first-child) {
      padding-top: 0;
    }
  }
  @media print {
    .layout {
      display: block;
    }
  }
  .docs {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-border-small);
    overflow: hidden;
  }
  .docs li + li {
    border-top: 1px solid var(--border);
  }
  .docs a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    color: var(--text);
  }
  .docs a:hover {
    background: var(--surface-hover);
    text-decoration: none;
  }
  .docs svg {
    flex: none;
    color: var(--text-subtle);
  }
  .doc-name {
    flex: 1;
    min-width: 0;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .details {
    margin: 0;
  }
  .details div {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
    padding: 10px 16px;
  }
  .details div + div {
    border-top: 1px solid var(--border);
  }
  .details dt {
    color: var(--text-subtle);
  }
  .details dd {
    margin: 0;
  }
  .specs {
    padding: 14px 16px;
    border-top: 1px solid var(--border);
  }
  p.label-12 {
    margin: 0;
  }
</style>
