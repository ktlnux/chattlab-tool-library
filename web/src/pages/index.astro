---
import Base from "../layouts/Base.astro";
import StatusBadge from "../components/StatusBadge.astro";
import Note from "../components/ui/Note.astro";
import { listMachines, fileUrl } from "../lib/pb";

const machines = await listMachines();
const unique = (values: string[]) => [...new Set(values.filter(Boolean))].sort();
const areas = unique(machines.map((m) => m.area));
const categories = unique(machines.map((m) => m.category));
// Set when the header search is submitted without picking a suggestion.
const initialQuery = Astro.url.searchParams.get("q") ?? "";
---

<Base title="All machines">
  <header class="page-header">
    <h1>Machines</h1>
    <p class="muted">
      Every machine has a QR sticker that links to its page. Browse or search them all here.
    </p>
  </header>

  <form class="filters" id="filters" onsubmit="return false">
    <div class="search">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <circle cx="7" cy="7" r="4.75"></circle>
        <path d="m10.5 10.5 3.25 3.25"></path>
      </svg>
      <input
        class="input"
        type="search"
        name="q"
        value={initialQuery}
        placeholder="Search name, make, model, code…"
        aria-label="Search machines"
      />
    </div>
    <select class="input" name="area" aria-label="Filter by area">
      <option value="">All areas</option>
      {areas.map((a) => <option value={a}>{a}</option>)}
    </select>
    <select class="input" name="category" aria-label="Filter by category">
      <option value="">All categories</option>
      {categories.map((c) => <option value={c}>{c}</option>)}
    </select>
  </form>

  <p class="count label-12 subtle" id="count" aria-live="polite">
    {machines.length} {machines.length === 1 ? "machine" : "machines"}
  </p>

  <ul class="grid" id="machine-list">
    {
      machines.map((m) => (
        <li
          data-area={m.area}
          data-category={m.category}
          data-search={[m.code, m.name, m.make, m.model, m.category, m.area].join(" ").toLowerCase()}
        >
          <a href={`/m/${m.code}`} class="machine-card">
            {m.photo ? (
              <img src={fileUrl(m, m.photo, "800x0")} alt="" loading="lazy" />
            ) : (
              <div class="placeholder mono" aria-hidden="true">
                {m.code}
              </div>
            )}
            <div class="body">
              <span class="name">{m.name}</span>
              <span class="status">
                <StatusBadge status={m.status} size="small" />
              </span>
              {(m.make || m.model) && <span class="copy-14 muted">{[m.make, m.model].filter(Boolean).join(" ")}</span>}
              <span class="meta label-12 subtle">
                <span class="mono">{m.code}</span>
                {m.area && <span>· {m.area}</span>}
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
  <div id="empty" hidden>
    <Note>No machines match your search.</Note>
  </div>
  {machines.length === 0 && <Note>No machines have been added yet.</Note>}
</Base>

<script>
  const form = document.getElementById("filters") as HTMLFormElement;
  const items = [...document.querySelectorAll<HTMLLIElement>("#machine-list > li")];
  const empty = document.getElementById("empty")!;
  const count = document.getElementById("count")!;

  function apply() {
    const data = new FormData(form);
    const q = String(data.get("q") ?? "").trim().toLowerCase();
    const area = String(data.get("area") ?? "");
    const category = String(data.get("category") ?? "");
    let shown = 0;
    for (const li of items) {
      const match =
        (!q || li.dataset.search!.includes(q)) &&
        (!area || li.dataset.area === area) &&
        (!category || li.dataset.category === category);
      li.hidden = !match;
      if (match) shown++;
    }
    empty.hidden = shown > 0 || items.length === 0;
    count.textContent = `${shown} ${shown === 1 ? "machine" : "machines"}`;
  }
  form.addEventListener("input", apply);
  apply();
</script>

<style>
  .page-header p {
    margin: 8px 0 0;
    max-width: 60ch;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .search {
    position: relative;
    flex: 1 1 260px;
  }
  .search svg {
    position: absolute;
    left: 12px;
    top: 12px;
    color: var(--text-subtle);
    pointer-events: none;
  }
  .search .input {
    width: 100%;
    padding-left: 36px;
  }
  .filters select {
    flex: 1 1 150px;
  }
  @media (min-width: 720px) {
    .filters select {
      flex: 0 0 180px;
    }
  }
  .count {
    margin: 16px 0 12px;
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    gap: 16px;
  }
  .machine-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-border-small);
    overflow: hidden;
    transition: box-shadow 0.15s ease;
  }
  .machine-card:hover {
    text-decoration: none;
    box-shadow: var(--shadow-border-medium), 0 0 0 1px var(--gray-500);
  }
  .machine-card img,
  .placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
  }
  .placeholder {
    display: grid;
    place-items: center;
    background: var(--background-200);
    color: var(--text-subtle);
    font-size: 20px;
    font-weight: 500;
  }
  .body {
    display: flex;
    flex-direction: column;
    padding: 10px 14px 12px;
  }
  .status {
    display: flex;
    margin: 2px 0 4px;
  }
  .name {
    font-weight: 600;
    line-height: 22px;
    letter-spacing: -0.01em;
  }
  .meta {
    display: flex;
    gap: 4px;
    margin-top: 2px;
  }
  #empty {
    margin-top: 8px;
  }
</style>
