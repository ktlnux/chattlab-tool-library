---
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
import Note from "../components/ui/Note.astro";
---

<Base title="Sign in">
  <div class="auth-card">
    <form id="signin" class="step">
      <h1 class="heading-24">Sign in</h1>
      <label class="field">
        <span class="label">Email</span>
        <input class="input" type="email" name="email" required autocomplete="email" inputmode="email" />
      </label>
      <label class="field">
        <span class="label-row">
          <span class="label">Password</span>
          <button type="button" class="link" data-show="reset">Forgot password?</button>
        </span>
        <span class="password">
          <input class="input" type="password" name="password" required autocomplete="current-password" />
          <button type="button" class="link reveal" aria-pressed="false">Show</button>
        </span>
      </label>
      <div class="error" hidden><Note variant="error"><span class="error-text"></span></Note></div>
      <Button type="submit" class="submit">Sign in</Button>
      <p class="copy-14 muted">
        New here? <button type="button" class="link" data-show="signup">Create an account</button>
      </p>
    </form>

    <form id="signup" class="step" hidden>
      <h1 class="heading-24">Create an account</h1>
      <label class="field">
        <span class="label">Email</span>
        <input class="input" type="email" name="email" required autocomplete="email" inputmode="email" />
      </label>
      <label class="field">
        <span class="label">Password</span>
        <span class="password">
          <input class="input" type="password" name="password" required minlength="8" autocomplete="new-password" />
          <button type="button" class="link reveal" aria-pressed="false">Show</button>
        </span>
        <span class="hint muted">At least 8 characters.</span>
      </label>
      <div class="error" hidden><Note variant="error"><span class="error-text"></span></Note></div>
      <Button type="submit" class="submit">Create account</Button>
      <p class="copy-14 muted">
        Already have an account? <button type="button" class="link" data-show="signin">Sign in</button>
      </p>
    </form>

    <form id="reset" class="step" hidden>
      <h1 class="heading-24">Reset your password</h1>
      <p class="copy-14 muted">We'll email you a link to choose a new password.</p>
      <label class="field">
        <span class="label">Email</span>
        <input class="input" type="email" name="email" required autocomplete="email" inputmode="email" />
      </label>
      <div class="error" hidden><Note variant="error"><span class="error-text"></span></Note></div>
      <div class="sent" hidden>
        <Note variant="success">
          If there's an account for that email, a reset link is on its way. Check spam if it doesn't arrive, or ask a
          steward to reset your password.
        </Note>
      </div>
      <Button type="submit" class="submit">Email me a link</Button>
      <p class="copy-14 muted"><button type="button" class="link" data-show="signin">Back to sign in</button></p>
    </form>
  </div>
</Base>

<script>
  import { ClientResponseError } from "pocketbase";
  import { pb, memberReady, missingContactInfo, errorMessage, LAST_EMAIL, type Member } from "../lib/client";

  const forms = {
    signin: document.getElementById("signin") as HTMLFormElement,
    signup: document.getElementById("signup") as HTMLFormElement,
    reset: document.getElementById("reset") as HTMLFormElement,
  };
  const params = new URLSearchParams(window.location.search);
  // Only return to pages on this site.
  const requested = params.get("next") ?? "/";
  const next = requested.startsWith("/") && !requested.startsWith("//") ? requested : "/";

  function show(name: keyof typeof forms) {
    // Carry the email over so it doesn't have to be typed twice.
    const email = Object.values(forms).find((form) => !form.hidden)?.querySelector<HTMLInputElement>("[name=email]")?.value;
    for (const [key, form] of Object.entries(forms)) form.hidden = key !== name;
    const emailInput = forms[name].querySelector<HTMLInputElement>("[name=email]")!;
    if (email && !emailInput.value) emailInput.value = email;
    (emailInput.value ? forms[name].querySelector<HTMLInputElement>("[name=password]") ?? emailInput : emailInput).focus();
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-show]")) {
    button.addEventListener("click", () => show(button.dataset.show as keyof typeof forms));
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(".reveal")) {
    button.addEventListener("click", () => {
      const input = button.previousElementSibling as HTMLInputElement;
      const showing = input.type === "password";
      input.type = showing ? "text" : "password";
      button.textContent = showing ? "Hide" : "Show";
      button.setAttribute("aria-pressed", String(showing));
      input.focus();
    });
  }

  // Signing back in on this device only needs the password.
  let lastEmail = "";
  try {
    lastEmail = localStorage.getItem(LAST_EMAIL) ?? "";
  } catch {}
  if (lastEmail) {
    forms.signin.querySelector<HTMLInputElement>("[name=email]")!.value = lastEmail;
    forms.reset.querySelector<HTMLInputElement>("[name=email]")!.value = lastEmail;
    forms.signin.querySelector<HTMLInputElement>("[name=password]")!.focus();
  }

  function showError(form: HTMLFormElement, message: string) {
    form.querySelector<HTMLElement>(".error-text")!.textContent = message;
    form.querySelector<HTMLElement>(".error")!.hidden = false;
  }

  async function busy<T>(form: HTMLFormElement, label: string, work: () => Promise<T>) {
    const button = form.querySelector<HTMLButtonElement>(".submit")!;
    const original = button.textContent;
    button.disabled = true;
    button.textContent = label;
    form.querySelector<HTMLElement>(".error")!.hidden = true;
    try {
      return await work();
    } finally {
      button.disabled = false;
      button.textContent = original;
    }
  }

  function finish(member: Member) {
    // New members (and anyone missing contact details) fill in their profile first.
    if (missingContactInfo(member).length > 0) {
      window.location.href = `/account?next=${encodeURIComponent(next)}`;
    } else {
      window.location.href = next;
    }
  }

  memberReady.then((member) => member && finish(member));

  function read(form: HTMLFormElement) {
    const data = new FormData(form);
    return {
      email: String(data.get("email") ?? "").trim(),
      password: String(data.get("password") ?? ""),
    };
  }

  forms.signin.addEventListener("submit", async (event) => {
    event.preventDefault();
    const { email, password } = read(forms.signin);
    try {
      const auth = await busy(forms.signin, "Signing in…", () => pb.collection("users").authWithPassword(email, password));
      finish(auth.record as Member);
    } catch (err) {
      showError(
        forms.signin,
        err instanceof ClientResponseError && err.status === 400
          ? "That email and password don't match. Check them, or reset your password."
          : errorMessage(err, "Couldn't sign you in. Please try again.")
      );
    }
  });

  forms.signup.addEventListener("submit", async (event) => {
    event.preventDefault();
    const { email, password } = read(forms.signup);
    try {
      const auth = await busy(forms.signup, "Creating account…", async () => {
        // The "Show" button stands in for typing the password twice.
        await pb.collection("users").create({ email, password, passwordConfirm: password });
        return pb.collection("users").authWithPassword(email, password);
      });
      finish(auth.record as Member);
    } catch (err) {
      const taken = err instanceof ClientResponseError && err.response?.data?.email?.code === "validation_not_unique";
      showError(
        forms.signup,
        taken
          ? "There's already an account with that email. Sign in, or reset your password."
          : errorMessage(err, "Couldn't create your account. Please try again.")
      );
    }
  });

  forms.reset.addEventListener("submit", async (event) => {
    event.preventDefault();
    const { email } = read(forms.reset);
    forms.reset.querySelector<HTMLElement>(".sent")!.hidden = true;
    try {
      await busy(forms.reset, "Sending…", () => pb.collection("users").requestPasswordReset(email));
      forms.reset.querySelector<HTMLElement>(".sent")!.hidden = false;
    } catch (err) {
      showError(forms.reset, errorMessage(err, "Couldn't send the email. Please try again."));
    }
  });
</script>

<style>
  .auth-card {
    max-width: 400px;
    margin: 24px auto;
    padding: 24px;
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-border-small);
  }
  .step {
    display: grid;
    gap: 16px;
  }
  .step[hidden] {
    display: none;
  }
  .step p {
    margin: -8px 0 0;
  }
  .step p:last-child {
    margin: 0;
  }
  .field {
    display: grid;
    gap: 6px;
  }
  .label-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .label {
    font-size: 14px;
    font-weight: 500;
  }
  .link {
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: var(--link);
    cursor: pointer;
  }
  .password {
    position: relative;
    display: block;
  }
  .password .input {
    width: 100%;
    padding-right: 64px;
  }
  .reveal {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    padding: 0 12px;
    font-size: 13px;
  }
  .label-row .link,
  .hint {
    font-size: 13px;
  }
  .link:hover {
    text-decoration: underline;
  }
</style>
