---
// Name and contact fields shared by the account page and the report dialog.
// Read and fill them with ./contact-fields.ts.
interface Props {
  /** Ask for an email address (visitors). Signed-in members already have one. */
  showEmail?: boolean;
}
const { showEmail = true } = Astro.props;
---

<div class="contact-fields">
  <div class="row">
    <label class="field">
      <span class="label">First name</span>
      <input class="input" name="first_name" maxlength="60" autocomplete="given-name" />
    </label>
    <label class="field">
      <span class="label">Last name</span>
      <input class="input" name="last_name" maxlength="60" autocomplete="family-name" />
    </label>
  </div>
  {
    showEmail && (
      <label class="field">
        <span class="label">Email</span>
        <input class="input" type="email" name="email" autocomplete="email" inputmode="email" />
      </label>
    )
  }
  <label class="field">
    <span class="label">Phone <span class="subtle">(optional)</span></span>
    <input class="input" type="tel" name="phone" maxlength="30" autocomplete="tel" />
  </label>
  <fieldset class="field">
    <legend class="label">Preferred way to contact you</legend>
    <div class="segmented">
      <label><input type="radio" name="preferred_contact" value="email" /><span>Email</span></label>
      <label><input type="radio" name="preferred_contact" value="phone" /><span>Phone</span></label>
      <label><input type="radio" name="preferred_contact" value="discord" /><span>Discord</span></label>
    </div>
  </fieldset>
  <label class="field discord" hidden>
    <span class="label">Discord username</span>
    <input class="input" name="discord_username" maxlength="60" autocomplete="off" />
  </label>
</div>

<script>
  // Show the Discord username field only when Discord is the preferred method.
  for (const root of document.querySelectorAll<HTMLElement>(".contact-fields")) {
    const discord = root.querySelector<HTMLElement>(".discord")!;
    const sync = () => {
      discord.hidden = root.querySelector<HTMLInputElement>("[name=preferred_contact]:checked")?.value !== "discord";
    };
    root.addEventListener("change", sync);
    root.addEventListener("contact-fields:filled", sync);
  }
</script>

<style>
  .contact-fields {
    display: grid;
    gap: 16px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .field {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: none;
    min-width: 0;
  }
  .field[hidden] {
    display: none;
  }
  .field .input {
    width: 100%;
  }
  .label {
    font-size: 14px;
    font-weight: 500;
    padding: 0;
  }
  .segmented {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    padding: 4px;
    border-radius: var(--radius-md);
    background: var(--gray-100);
    box-shadow: inset 0 0 0 1px var(--gray-alpha-400);
  }
  .segmented label {
    position: relative;
    cursor: pointer;
  }
  .segmented input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .segmented span {
    display: grid;
    place-items: center;
    height: 32px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
  }
  .segmented input:checked + span {
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-border-small);
  }
  .segmented input:focus-visible + span {
    box-shadow: var(--focus-ring);
  }
</style>
