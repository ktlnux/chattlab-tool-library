---
import type { TroubleshootingEntry } from "../lib/pb";

interface Props {
  entries: TroubleshootingEntry[];
}
const { entries } = Astro.props;
---

<div class="accordion">
  {
    entries.map((entry) => (
      <details>
        <summary>
          <span>{entry.symptom}</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m4 6 4 4 4-4" />
          </svg>
        </summary>
        <div class="answer">
          {entry.likely_cause && (
            <p class="cause copy-14">
              <span class="label-12 subtle">Likely cause</span>
              {entry.likely_cause}
            </p>
          )}
          {entry.fix && <div class="prose" set:html={entry.fix} />}
        </div>
      </details>
    ))
  }
</div>

<style>
  .accordion {
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-border-small);
    overflow: hidden;
  }
  details + details {
    border-top: 1px solid var(--border);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--surface-hover);
  }
  summary svg {
    flex: none;
    color: var(--text-subtle);
    transition: transform 0.2s var(--ease);
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  .answer {
    padding: 0 16px 16px;
  }
  .cause {
    display: grid;
    gap: 2px;
    margin: 0 0 12px;
    color: var(--text-muted);
  }
  .cause span {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
