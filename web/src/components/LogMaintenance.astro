---
// "Log maintenance" button and dialog. Signed-in members add entries to maintenance_logs;
// visitors are sent to sign in first.
import Button from "./ui/Button.astro";
import Note from "./ui/Note.astro";

interface Props {
  machineId: string;
  machineName: string;
}
const { machineId, machineName } = Astro.props;
---

<div class="log-maintenance" data-machine-id={machineId}>
  <Button type="button" variant="secondary" size="small" class="open-log">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M8 3.25v9.5M3.25 8h9.5"></path>
    </svg>
    Log maintenance
  </Button>

  <dialog class="log-dialog" aria-labelledby="log-title">
    <form class="log-form" novalidate>
      <header>
        <div>
          <h2 id="log-title" class="heading-20">Log maintenance</h2>
          <p class="copy-14 muted">{machineName}</p>
        </div>
        <button type="button" class="close" aria-label="Close">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="m4 4 8 8M12 4l-8 8"></path>
          </svg>
        </button>
      </header>
      <div class="fields">
        <label class="field">
          <span class="label">What was done?</span>
          <input class="input" name="title" required maxlength="150" placeholder="e.g. Replaced blade, waxed table" autocomplete="off" />
        </label>
        <label class="field">
          <span class="label">Notes <span class="subtle">(optional)</span></span>
          <textarea class="input" name="notes" rows="3" maxlength="4000" placeholder="Parts used, settings, anything the next person should know"></textarea>
        </label>
        <label class="field date">
          <span class="label">Date</span>
          <input class="input" type="date" name="performed_on" />
        </label>
        <div class="error" hidden><Note variant="error"><span class="error-text"></span></Note></div>
      </div>
      <footer>
        <Button type="button" variant="secondary" class="cancel">Cancel</Button>
        <Button type="submit" class="submit">Save</Button>
      </footer>
    </form>
  </dialog>
</div>

<script>
  import { pb, currentMember, errorMessage, signInUrl } from "../lib/client";

  for (const root of document.querySelectorAll<HTMLElement>(".log-maintenance")) {
    const dialog = root.querySelector("dialog")!;
    const form = root.querySelector<HTMLFormElement>(".log-form")!;
    const errorBox = root.querySelector<HTMLElement>(".error")!;

    // Today's date in the member's own time zone, for the date input.
    const today = () => {
      const now = new Date();
      return new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    };

    root.querySelector(".open-log")!.addEventListener("click", () => {
      if (!currentMember()) {
        window.location.assign(signInUrl(window.location.pathname + "#history"));
        return;
      }
      form.reset();
      errorBox.hidden = true;
      const date = form.querySelector<HTMLInputElement>("[name=performed_on]")!;
      date.value = today();
      date.max = today();
      dialog.showModal();
      form.querySelector<HTMLInputElement>("[name=title]")!.focus();
    });
    const close = () => dialog.close();
    root.querySelector(".close")!.addEventListener("click", close);
    root.querySelector(".cancel")!.addEventListener("click", close);
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorBox.hidden = true;
      const data = new FormData(form);
      const title = String(data.get("title") ?? "").trim();
      if (!title) {
        root.querySelector(".error-text")!.textContent = "Say briefly what was done.";
        errorBox.hidden = false;
        return;
      }
      const day = String(data.get("performed_on") ?? "");
      const button = root.querySelector<HTMLButtonElement>(".submit")!;
      button.disabled = true;
      try {
        await pb.collection("maintenance_logs").create({
          machine: root.dataset.machineId,
          title,
          notes: String(data.get("notes") ?? "").trim(),
          // Only backdated work gets a date: a calendar day, stored at midnight UTC and shown
          // without converting time zones. Work done today is placed by when it was logged.
          performed_on: day && day !== today() ? `${day} 00:00:00.000Z` : "",
        });
        window.location.hash = "history";
        window.location.reload();
      } catch (err) {
        root.querySelector(".error-text")!.textContent = errorMessage(err, "Couldn't save. Please try again.");
        errorBox.hidden = false;
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .log-dialog {
    width: min(440px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: none;
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-border-medium), 0 24px 48px -12px #00000040;
    overflow-y: auto;
  }
  .log-dialog::backdrop {
    background: #0000004d;
  }
  @media (max-width: 719px) {
    .log-dialog {
      margin-top: 16px;
    }
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 20px 20px 0;
  }
  .heading-20 {
    font-size: 20px;
    line-height: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }
  header p {
    margin: 2px 0 0;
  }
  .close {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin: -4px -8px 0 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .close:hover {
    background: var(--gray-alpha-100);
  }
  .fields {
    display: grid;
    gap: 16px;
    padding: 20px;
  }
  .field {
    display: grid;
    gap: 6px;
  }
  .label {
    font-size: 14px;
    font-weight: 500;
  }
  .date .input {
    max-width: 200px;
  }
  textarea.input {
    height: auto;
    padding: 10px 12px;
    line-height: 20px;
    resize: vertical;
  }
  footer {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    padding: 14px 20px;
    border-top: 1px solid var(--border);
    background: var(--background-200);
  }
</style>
