---
interface Props {
  variant?: "gray" | "blue" | "red" | "amber" | "green";
  size?: "small" | "medium";
}
const { variant = "gray", size = "medium" } = Astro.props;
---

<span class:list={["badge", variant, size]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: 999px;
    font-weight: 500;
    white-space: nowrap;
  }
  .small {
    height: 20px;
    padding: 0 6px;
    font-size: 11px;
  }
  .medium {
    height: 24px;
    padding: 0 10px;
    font-size: 12px;
  }
  .gray {
    background: var(--gray-200);
    color: var(--gray-1000);
  }
  .blue {
    background: var(--blue-200);
    color: var(--blue-900);
  }
  .red {
    background: var(--red-200);
    color: var(--red-900);
  }
  .amber {
    background: var(--amber-200);
    color: var(--amber-900);
  }
  .green {
    background: var(--green-200);
    color: var(--green-900);
  }
</style>
